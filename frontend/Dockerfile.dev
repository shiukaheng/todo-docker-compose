FROM node:20-alpine

WORKDIR /app

# Copy package files and install deps
COPY repo/package*.json ./
RUN npm ci

# App code will be mounted at runtime
EXPOSE 3000

# Inject API_URL into index.html and start dev server
CMD sh -c '\
    if [ -n "$API_URL" ]; then \
        sed -i "s|defaultApiUrl: null|defaultApiUrl: \"${API_URL}\"|g" /app/index.html; \
        echo "Configured API_URL: $API_URL"; \
    fi && \
    npm run dev -- --host 0.0.0.0'
